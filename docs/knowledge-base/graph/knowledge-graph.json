   "id": "con:restart-policy",
   "kind": "concept",
   "name": "Restart policy",
   "summary": "A run shorter than min_uptime is unstable. max_restarts counts consecutive unstable runs, then status errored. Backoff doubles up to 15 s. stop_exit_codes end supervision."
  },
  {
   "id": "con:soft-restart",
   "kind": "concept",
   "name": "Soft restart",
   "summary": "watch, cron_restart and max_memory_restart restart at once, count in restarts, never count as unstable, report their own reason."
  },
  {
   "id": "con:instances",
   "kind": "concept",
   "name": "Instances",
   "summary": "instances: N runs N processes under one name with PMGO_INSTANCE_ID. scale changes the count live; reload restarts one at a time."
  },
  {
   "id": "con:shared-socket",
   "kind": "concept",
   "name": "Shared listening socket",
   "summary": "Daemon opens the listener once per app and passes it as fd 3 (LISTEN_FDS=1) to every instance. Gives cluster-style port sharing and zero-downtime reload (#98)."
  },
  {
   "id": "con:wait-ready",
   "kind": "concept",
   "name": "wait_ready",
   "summary": "App signals readiness through a pipe; reload waits for it before stopping the old instance (#98)."
  },
  {
   "id": "con:agent-outbound",
   "kind": "concept",
   "name": "Agent connects outbound",
   "summary": "Hosts dial the hub; the hub never connects to hosts, so monitored hosts need no inbound port."
  },
  {
   "id": "con:sustained-threshold",
   "kind": "concept",
   "name": "Sustained threshold",
   "summary": "A metric rule fires only after the condition holds for duration_s. repeat_s sends reminders while firing; resolve needs 10 s of false."
  },
  {
   "id": "con:escalation",
   "kind": "concept",
   "name": "Escalation",
   "summary": "Several rules of one type with rising thresholds and levels. While the higher level fires for the same target, the lower level stays quiet."
  },
  {
   "id": "con:issue-fingerprint",
   "kind": "concept",
   "name": "Issue fingerprint",
   "summary": "Error lines reduced to a stable shape (timestamps, numbers, hex ids, quoted values removed) so repeats group together."
  },
  {
   "id": "con:trust-proxy",
   "kind": "concept",
   "name": "Trusted proxy",
   "summary": "PMGO_TRUST_PROXY=1 makes the hub believe X-Forwarded-For and X-Forwarded-Proto. Only safe behind Caddy on a private port."
  },
  {
   "id": "con:schema-migrations",
   "kind": "concept",
   "name": "Schema migrations",
   "summary": "Append-only versioned migrations; downgrade is refused."
  },
  {
   "id": "con:per-issue-files",
   "kind": "concept",
   "name": "Per-issue work files",
   "summary": "Each session writes status, decisions and notes only to its own pm2go-work/\u003cNNN\u003e-*.md file so parallel PRs never conflict on shared docs."
  },
  {
   "id": "con:integration-branch",
   "kind": "concept",
   "name": "Integration branch",
   "summary": "feat/pm2go-process-manager collects every feature PR; PR #88 merges it to main once, because main runs release workflows on every push."
  },
  {
   "id": "con:children-tied-to-daemon",
   "kind": "concept",
   "name": "Children tied to the daemon",
   "summary": "Child output goes through daemon pipes, so children die with the daemon. KillMode=control-group in the unit. Fix tracked in #99."
  },
  {
   "id": "flow:start",
   "kind": "flow",
   "name": "Start an app",
   "summary": "CLI builds AppConfig (flags or ecosystem) -\u003e RPC start -\u003e Manager.Start creates or updates Procs by name -\u003e Proc.Start spawns the supervise loop."
  },
  {
   "id": "flow:telemetry",
   "kind": "flow",
   "name": "Telemetry",
   "summary": "Monitor samples /proc every 2 s -\u003e Proc caches usage -\u003e Agent builds Snapshot every 2 s -\u003e Hub Registry.OnSnapshot -\u003e SQLite every 10 s -\u003e dashboard charts."
  },
  {
   "id": "flow:log-stream",
   "kind": "flow",
   "name": "Log stream",
   "summary": "Child output -\u003e RotatingFile (file + line hook) -\u003e Agent batch (500 ms) -\u003e Registry ring + issue grouping + live subscribers -\u003e dashboard WebSocket."
  },
  {
   "id": "flow:alerting",
   "kind": "flow",
   "name": "Alerting",
   "summary": "Engine.Evaluate every 2 s over Registry states -\u003e per rule state machine -\u003e level suppression -\u003e Notifier -\u003e Telegram; history stored in SQLite."
  },
  {
   "id": "flow:remote-command",
   "kind": "flow",
   "name": "Remote command",
   "summary": "Browser POST /api/servers/{name}/command -\u003e Registry.Command -\u003e agent exec -\u003e Manager method -\u003e CommandResult back to the browser."
  },
