# For a Caddy that already runs on the host. Add this block to your Caddyfile
# (usually /etc/caddy/Caddyfile), replace the domain, then: sudo systemctl reload caddy
pm2.example.com {
	encode zstd gzip

	# Dashboard, API and agent WebSockets (/agent/ws, /api/logs/ws) all go to the hub.
	# Caddy upgrades WebSocket connections without extra settings and sends
	# X-Forwarded-For and X-Forwarded-Proto, which the hub trusts (PMGO_TRUST_PROXY=1).
	reverse_proxy 127.0.0.1:8080 {
		health_uri /healthz
		health_interval 30s
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
