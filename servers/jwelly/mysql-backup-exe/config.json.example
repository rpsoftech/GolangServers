{
  "databases": [
    {
      "name": "jwelly-main",
      "mysqlConfig": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": 3306,
        "MYSQL_USERNAME": "root",
        "MYSQL_PASSWORD": "",
        "MYSQL_DATABASE": "jwelly"
      },
      "engine": "auto",
      "mysqldumpPath": "",
      "stripDefiner": false,
      "cron": "0 2 * * *",
      "runOnStart": false,
      "retries": 3,
      "timeoutMinutes": 360,
      "destinations": [
        {
          "type": "fileServer",
          "url": "https://files.example.com/upload",
          "token": "change-me",
          "folderPath": "backups/jwelly"
        },
        {
          "type": "local",
          "path": "D:\\Backups\\jwelly",
          "keepLast": 7,
          "keepDays": 0
        }
      ]
    }
  ]
}
